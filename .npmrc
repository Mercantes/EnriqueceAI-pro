# node-linker=hoisted: instala node_modules em layout flat (sem symlinks .pnpm).
# Necessário para o Next `output: 'standalone'` no Docker — o tracing do
# standalone não segue os symlinks do pnpm e gera MODULE_NOT_FOUND em runtime
# (quebrou no upgrade Next 16.1.6 -> 16.3.1, cujo hash .pnpm mudou).
node-linker=hoisted
